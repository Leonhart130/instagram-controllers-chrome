{
  "manifest_version": 3,
  "name": "Instagram Video Controls",
  "version": "0.2.0",
  "description": "Real video controls on Instagram: play/pause, scrubbing, volume, playback speed and fullscreen.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
