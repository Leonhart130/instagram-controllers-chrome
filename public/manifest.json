{
  "manifest_version": 3,
  "name": "Instagram Video Controls",
  "version": "0.1.0",
  "description": "Adds a real video player bar to Instagram: play/pause, scrubbing, volume and fullscreen.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
