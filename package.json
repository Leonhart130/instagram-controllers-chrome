{
  "name": "ins-vcont",
  "version": "0.1.0",
  "description": "Chrome extension adding real video controls to Instagram",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leonhart130/instagram-controllers-chrome.git"
  },
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "serve": "node scripts/serve.mjs",
    "fixture": "node scripts/fixture.mjs",
    "e2e": "npm run build && node scripts/e2e.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "typecheck": "tsc --noEmit",
    "harness": "npm run build && node scripts/harness.mjs",
    "check": "npm run harness && npm run reels && npm run e2e",
    "reels": "npm run build && node scripts/reels.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}
